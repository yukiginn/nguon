{
  "id": "plugin_monkeydd",
  "name": "MonkeyD",
  "version": "1.0.0",
  "author": "Truyện TTS",
  "description": "Kho truyện ngôn tình, cổ đại, truyện Zhihu và truyện dịch cập nhật liên tục trên MonkeyD. Không cần đăng nhập.",
  "language": "vi",
  "baseUrl": "https://www.monkeydd.com",
  "mirrorUrls": [
    "https://monkeydd.com"
  ],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "requestDelayMs": 300,
  "customHeaders": {
    "Cookie": "affDisplayInChapter=true; affShopeeFoodClicked=true"
  },
  "chapterPageSize": 50,
  "defaultCategory": "Truyện mới",
  "enabled": true,
  "authConfig": {
    "supportsLogin": false,
    "loginUrl": "",
    "loginHint": "",
    "authCookieKeys": [],
    "lockedChapterMarkers": [],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "selectors": {
    "listUrlTemplate": "{baseUrl}{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}{categoryPath}?page={page}",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/tim-kiem?search={query}",
    "chapterPageUrlTemplate": "",
    "listItemSelector": ".single-story-block",
    "listTitleSelector": ".single-story-details h3 a",
    "listAuthorSelector": "",
    "listCoverSelector": ".single-story-img img",
    "listLatestChapterSelector": ".single-story-details .chapter-name, .episode-title a",
    "detailTitleSelector": ".page-comics-detail h2.card-title",
    "detailAuthorSelector": ".page-comics-detail dl a[href*='/nhom-dich/'] b",
    "detailCoverSelector": ".page-comics-detail .col-md-3 img.img-fluid",
    "detailDescriptionSelector": ".story-description .inner",
    "detailStatusSelector": ".page-comics-detail dl dd:last-of-type",
    "detailGenreSelector": ".page-comics-detail a.cate-item",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#listChapters .list-chapters .episode-title a",
    "chapterListStartAfterText": "",
    "chapterListExcludeSelector": "",
    "chapterListReverse": true,
    "chapterTitleSelector": "#chapterContentLoading h1.card-title",
    "chapterContentSelector": "#chapter-content-render .actac",
    "chapterNextPageSelector": "",
    "removeElementsSelector": ".actcl, #spf-img, .signature, .my-4, #affGateModal, script, style, input",
    "prevChapterSelector": "",
    "nextChapterSelector": "",
    "blockedUrlPatterns": [
      "s.shopee.vn",
      "s.lazada.vn",
      "vt.tiktok.com",
      "monkeydtruyen.cc"
    ],
    "invalidCoverPatterns": [
      "ajax-loading.gif",
      "no-image.png",
      "Logo-MonkeyD.png",
      "unlock-ytb-link.png",
      "click-here-to-unlock.jpg"
    ],
    "coverUrlReplacements": [],
    "coverFallbackTemplate": "",
    "preferDetailHdCover": false,
    "bookIdExtractRegex": "/([^/]+)\\.html$"
  },
  "cleanRules": [
    {
      "pattern": "\\[Truyện được đăng tải duy nhất tại[^\\]]*\\]",
      "replacement": "",
      "isRegex": true,
      "ignoreCase": true
    },
    {
      "pattern": "(?i)(?:https?://)?(?:www\\.)?monkeydd\\.com[^\\s]*",
      "replacement": "",
      "isRegex": true,
      "ignoreCase": true
    },
    {
      "pattern": "(?<=\\p{L})/(?=\\p{L})",
      "replacement": "",
      "isRegex": true,
      "ignoreCase": false
    }
  ],
