{
  "id": "plugin_nguontrung_5in1",
  "name": "69 Thư Ba (69shuba)",
  "version": "3.0.0",
  "author": "Cộng đồng Truyện TTS",
  "description": "Nguồn truyện tiếng Trung 69 Thư Ba (www.69shuba.com) chạy 100% bằng cấu hình JSON độc lập, đầy đủ 17 bảng xếp hạng & thể loại, bảng mã GB18030 và tự dịch VietPhrase/AI.",
  "language": "zh",
  "baseUrl": "https://www.69shuba.com",
  "mirrorUrls": [
    "https://69shuba.com",
    "https://www.69shu.com",
    "https://69shuba.cx"
  ],
  "driverType": "configurable_css",
  "charset": "GB18030",
  "searchMethod": "POST",
  "searchBodyTemplate": "searchkey={query}&searchtype=all",
  "requestDelayMs": 250,
  "chapterPageSize": 100,
  "defaultCategory": "69shu Bảng Xếp Hạng",
  "enabled": true,
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}/{categoryPath}/{page}.htm",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/modules/article/search.php",
    "listItemSelector": "#article_list_content li, .newbox ul li, .mybox ul li",
    "listTitleSelector": "h3 a:last-of-type, h3 a, .newnav h3 a",
    "listAuthorSelector": "div.labelbox label:first-child, .labelbox label",
    "listCoverSelector": "img[data-src], img",
    "listLatestChapterSelector": ".zxzj p a, .zxzj p",
    "detailTitleSelector": ".booknav2 h1 a, .booknav2 h1, h1",
    "detailAuthorSelector": ".booknav2 p a[href*='author'], .booknav2 p:first-of-type a",
    "detailCoverSelector": ".bookimg2 img, meta[property='og:image'], img[src*='/files/article/image/']",
    "detailDescriptionSelector": ".navtxt p, .navtxt",
    "detailStatusSelector": ".booknav2 p",
    "detailGenreSelector": ".booknav2 p a[href*='/class/']",
    "detailChapterListUrlSelector": "a.more-btn, a[href*='/book/'][href$='/']",
    "chapterListSelector": "div.catalog ul li a, #catalog ul li a, a[href*='/txt/']",
    "chapterListExcludeSelector": "#bookcase",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": ".txtnav h1, h1",
    "chapterContentSelector": ".txtnav",
    "removeElementsSelector": "script, style, noscript, iframe, h1, .txtinfo, .page1, .bottom-ad2, .setbox, #baocuo, .contentadv, .ads, table",
    "prevChapterSelector": ".page1 a:contains(上一章)",
    "nextChapterSelector": ".page1 a:contains(下一章)",
    "coverFallbackTemplate": "https://cdn.cdnshu.com/files/article/image/{bookIdDiv1000}/{bookId}/{bookId}s.jpg",
    "bookIdExtractRegex": "/book/(\\d+)"
  },
  "cleanRules": [
    { "pattern": "69书吧|www\\.69shuba\\.com|69shuba\\.cx|69shu\\.com", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "\\(本章完\\)|本章完|请收藏本站.*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ],
  "categories": [
    { "name": "69shu Bảng Xếp Hạng", "urlOrPath": "novels/hot", "pageUrlOrPath": "novels/monthvisit_0_0_{page}.htm", "group": "Bảng xếp hạng", "isDefaultHome": true },
    { "name": "Đọc Nhiều Trong Tháng", "urlOrPath": "novels/monthvisit_0_0_1.htm", "pageUrlOrPath": "novels/monthvisit_0_0_{page}.htm", "group": "Bảng xếp hạng", "isDefaultHome": false },
    { "name": "Truyện Mới Hot", "urlOrPath": "novels/newhot_0_0_1.htm", "pageUrlOrPath": "novels/newhot_0_0_{page}.htm", "group": "Bảng xếp hạng", "isDefaultHome": false },
    { "name": "Đề Cử Nhiều Nhất", "urlOrPath": "novels/allvote_0_0_1.htm", "pageUrlOrPath": "novels/allvote_0_0_{page}.htm", "group": "Bảng xếp hạng", "isDefaultHome": false },
    { "name": "Truyện Đã Hoàn Thành", "urlOrPath": "novels/full", "pageUrlOrPath": "novels/full/{page}.htm", "group": "Bảng xếp hạng", "isDefaultHome": false },
    { "name": "Huyền Huyễn Ma Pháp", "urlOrPath": "novels/class/1.htm", "pageUrlOrPath": "novels/class/1/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Tu Chân Võ Hiệp", "urlOrPath": "novels/class/2.htm", "pageUrlOrPath": "novels/class/2/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Ngôn Tình", "urlOrPath": "novels/class/3.htm", "pageUrlOrPath": "novels/class/3/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Lịch Sử Quân Sự", "urlOrPath": "novels/class/4.htm", "pageUrlOrPath": "novels/class/4/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Võng Du Cạnh Kỹ", "urlOrPath": "novels/class/5.htm", "pageUrlOrPath": "novels/class/5/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Khoa Huyễn Không Gian", "urlOrPath": "novels/class/6.htm", "pageUrlOrPath": "novels/class/6/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Huyền Nghi Linh Dị", "urlOrPath": "novels/class/7.htm", "pageUrlOrPath": "novels/class/7/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Đồng Nhân", "urlOrPath": "novels/class/8.htm", "pageUrlOrPath": "novels/class/8/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Đô Thị", "urlOrPath": "novels/class/9.htm", "pageUrlOrPath": "novels/class/9/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Quan Trường Chức Trường", "urlOrPath": "novels/class/10.htm", "pageUrlOrPath": "novels/class/10/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Xuyên Không Thời Không", "urlOrPath": "novels/class/11.htm", "pageUrlOrPath": "novels/class/11/{page}.htm", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Thanh Xuân Vườn Trường", "urlOrPath": "novels/class/12.htm", "pageUrlOrPath": "novels/class/12/{page}.htm", "group": "Thể loại", "isDefaultHome": false }
  ]
}
