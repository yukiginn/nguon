{
  "id": "plugin_truyenyy_vi",
  "name": "Truyện YY (TruyenYY.co)",
  "version": "2.1.0",
  "author": "Cộng đồng Truyện TTS",
  "description": "Nguồn truyện tiếng Việt Truyện YY (truyenyy.co) đã kiểm tra thực tế (HTTP 200), hỗ trợ 14 danh sách & chủ đề, mục lục chương và đăng nhập tài khoản WebView.",
  "language": "vi",
  "baseUrl": "https://truyenyy.co",
  "mirrorUrls": [],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "searchMethod": "GET",
  "requestDelayMs": 250,
  "chapterPageSize": 100,
  "defaultCategory": "Mới Cập Nhật",
  "enabled": true,
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://truyenyy.co/dang-nhap",
    "loginHint": "Đăng nhập tài khoản Truyện YY của bạn để đọc các chương VIP đã mở khóa.",
    "authCookieKeys": ["sessionid", "token", "auth"],
    "lockedChapterMarkers": ["Chương VIP", "Mở khóa chương", "vui lòng đăng nhập"],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{categoryUrl}?page={page}",
    "searchUrlTemplate": "{baseUrl}/tim-kiem/nang-cao?q={query}&page={page}",
    "listItemSelector": "ul.flex.flex-col > li, li:has(a[href^='/truyen/'] h3)",
    "listTitleSelector": "a[href^='/truyen/']:has(h3), a[href^='/truyen/'] h3",
    "listAuthorSelector": "p.text-small",
    "listCoverSelector": "img.cover-image, img",
    "listLatestChapterSelector": "p.text-small.line-clamp-2",
    "detailTitleSelector": "h1",
    "detailAuthorSelector": "a[href*='/tac-gia/'], p.text-small",
    "detailCoverSelector": "meta[property='og:image'], img.cover-image",
    "detailDescriptionSelector": "meta[name='description'], article, p",
    "detailStatusSelector": "span, p",
    "detailGenreSelector": "a[href*='/tim-kiem/nang-cao?q=']",
    "detailChapterListUrlSelector": "a[href*='danh-sach-chuong']",
    "chapterListSelector": "a[href*='/chuong-']",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}/danh-sach-chuong?page={page}",
    "chapterTitleSelector": "h1, h2",
    "chapterContentSelector": "article",
    "removeElementsSelector": "script, style, noscript, iframe, .ads, button, svg",
    "prevChapterSelector": "a[href*='/chuong-']:contains(Trước), a[rel='prev']",
    "nextChapterSelector": "a[href*='/chuong-']:contains(Tiếp), a[rel='next']"
  },
  "cleanRules": [
    { "pattern": "TruyenYY\\.co|truyenyy\\.co", "replacement": "", "isRegex": true, "ignoreCase": true }
  ],
  "categories": [
    { "name": "Mới Cập Nhật", "urlOrPath": "truyen-moi-cap-nhat", "group": "Danh sách", "isDefaultHome": true },
    { "name": "Truyện Dịch YY", "urlOrPath": "truyen-dich-yy", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Truyện Mới Đăng", "urlOrPath": "truyen-moi-dang", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Truyện Teen", "urlOrPath": "truyen-teen", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Tiên Hiệp", "urlOrPath": "tim-kiem/nang-cao?q=tiên+hiệp", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Huyền Huyễn", "urlOrPath": "tim-kiem/nang-cao?q=huyền+huyễn", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Đô Thị", "urlOrPath": "tim-kiem/nang-cao?q=đô+thị", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Ngôn Tình", "urlOrPath": "tim-kiem/nang-cao?q=ngôn+tình", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Hệ Thống", "urlOrPath": "tim-kiem/nang-cao?q=hệ+thống", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Trọng Sinh", "urlOrPath": "tim-kiem/nang-cao?q=trọng+sinh", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Mạt Thế", "urlOrPath": "tim-kiem/nang-cao?q=mạt+thế", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Hồng Hoang", "urlOrPath": "tim-kiem/nang-cao?q=hồng+hoang", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Phản Phái", "urlOrPath": "tim-kiem/nang-cao?q=phản+phái", "group": "Chủ đề", "isDefaultHome": false },
    { "name": "Thần Hào", "urlOrPath": "tim-kiem/nang-cao?q=thần+hào", "group": "Chủ đề", "isDefaultHome": false }
  ]
}
