{
  "id": "sangtacviet_vi",
  "name": "Sáng Tác Việt (SangTacViet)",
  "version": "2.0.0",
  "author": "Cộng Đồng Plugin",
  "description": "Nguồn đọc & dịch nhanh nổi tiếng tại Việt Nam, hỗ trợ đăng nhập tài khoản WebView / Cookie và nhiều tên miền dự phòng.",
  "driver": "generic",
  "language": "vi",
  "isChineseSource": false,
  "baseUrl": "https://sangtacviet.vip",
  "mirrorUrls": [
    "https://sangtacviet.pro",
    "https://sangtacviet.com",
    "https://sangtacvietfpt.com"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 350,
  "customHeaders": {
    "Accept-Language": "vi-VN,vi;q=0.9,en;q=0.8"
  },
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://sangtacviet.vip/user/login",
    "loginHint": "Đăng nhập tài khoản Sáng Tác Việt để đồng bộ tủ sách và mở các chương giới hạn thành viên.",
    "authCookieKeys": ["PHPSESSID", "user", "token", "cf_clearance"],
    "lockedChapterMarkers": [
      "Vui lòng đăng nhập",
      "Bạn cần đăng nhập",
      "mở khóa chương",
      "Chương VIP",
      "Đăng nhập để tiếp tục"
    ],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "hot", "name": "Truyện Xem Nhiều", "urlPath": "?find=&sort=viewday&p=1" },
    { "id": "new", "name": "Mới Cập Nhật", "urlPath": "?find=&sort=update&p=1" },
    { "id": "tienhiep", "name": "Tiên Hiệp", "urlPath": "?find=&category=tienhiep&p=1" },
    { "id": "huyenhuyen", "name": "Huyền Huyễn", "urlPath": "?find=&category=huyenhuyen&p=1" },
    { "id": "ngontinh", "name": "Ngôn Tình", "urlPath": "?find=&category=ngontinh&p=1" },
    { "id": "dothi", "name": "Đô Thị", "urlPath": "?find=&category=dothi&p=1" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}/?find=&sort=update&p={page}",
    "searchUrlTemplate": "{baseUrl}/?find={query}&p={page}",
    "listItemSelector": "#searchviewdiv a.booksearch, .booksearch, .search-item",
    "listTitleSelector": ".searchbooktitle, b, h3",
    "listAuthorSelector": ".searchtag, .author",
    "listCoverSelector": "img",
    "listLatestChapterSelector": ".searchbookchap",
    "detailTitleSelector": "#book_name2, h1.book-title, h1",
    "detailAuthorSelector": "h2 a[href*='author'], .blk-arr a, .author",
    "detailCoverSelector": ".container img[src*='cover'], meta[property='og:image']",
    "detailDescriptionSelector": "#book-sumary, .book-sumary, meta[property='og:description']",
    "detailStatusSelector": ".blk-arr",
    "detailGenreSelector": ".blk-arr a[href*='category']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#chapterlist a, .chapter-list a, a.listchapitem",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": "#bookchapnameholder, h1.chapter-title, h1",
    "chapterContentSelector": "#content-container .contentbox, .contentbox, #maincontent",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, noscript, iframe, .ads, .btn, div[class*='ad']",
    "prevChapterSelector": "#navprevtop, a:contains(Chương trước)",
    "nextChapterSelector": "#navnexttop, a:contains(Chương sau)"
  },
  "cleanRules": [
    { "pattern": "sangtacviet\\.[a-z]+", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
