{
  "id": "shuhaige_cn",
  "name": "Thư Hải Các (Shuhaige)",
  "version": "2.0.0",
  "author": "Cộng Đồng Plugin",
  "description": "Nguồn Trung bản di động tốc độ cực nhanh, tự động ghép các trang chương con khi chương bị tách nhiều trang.",
  "driver": "generic",
  "language": "zh",
  "isChineseSource": true,
  "baseUrl": "https://m.shuhaige.net",
  "mirrorUrls": [
    "https://www.shuhaige.net",
    "https://m.shuhaige.com"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "POST",
  "searchBodyTemplate": "searchkey={query}&searchtype=all",
  "requestDelayMs": 300,
  "customHeaders": {
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "authConfig": {
    "supportsLogin": false,
    "loginUrl": "https://m.shuhaige.net/",
    "loginHint": "Nguồn đọc miễn phí tối ưu cho di động.",
    "authCookieKeys": [],
    "lockedChapterMarkers": [],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "all", "name": "Bảng Xếp Hạng", "urlPath": "top.html" },
    { "id": "xuanhuan", "name": "Huyền Huyễn", "urlPath": "sort/1_1/" },
    { "id": "xianxia", "name": "Tiên Hiệp", "urlPath": "sort/2_1/" },
    { "id": "dushi", "name": "Đô Thị", "urlPath": "sort/3_1/" },
    { "id": "lishi", "name": "Lịch Sử", "urlPath": "sort/4_1/" },
    { "id": "kehuan", "name": "Khoa Huyễn", "urlPath": "sort/6_1/" },
    { "id": "full", "name": "Truyện Hoàn Thành", "urlPath": "full/1/" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}/full/{page}/",
    "searchUrlTemplate": "{baseUrl}/search.html",
    "listItemSelector": "ul.list li, .bookbox, .hot_sale",
    "listTitleSelector": "p.bookname a, a.bookname, h3 a, a[href*='/shu_']",
    "listAuthorSelector": "p.data a, .author",
    "listCoverSelector": "img",
    "listLatestChapterSelector": "p.chapter a, .lastchapter",
    "detailTitleSelector": ".detail p.name strong, .bookinfo h1, h1",
    "detailAuthorSelector": ".detail p.author a, .author",
    "detailCoverSelector": ".detail img, meta[property='og:image']",
    "detailDescriptionSelector": ".intro, .bookintro, meta[property='og:description']",
    "detailStatusSelector": ".detail p",
    "detailGenreSelector": ".detail p a",
    "detailChapterListUrlSelector": "a:contains(查看完整目录), a[href$='/']",
    "chapterListSelector": "ul.read li a, #list dd a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": "h1.headline, .headline, h1",
    "chapterContentSelector": ".content, #content",
    "chapterNextPageSelector": "a#next_url:contains(下一页), .pager a:contains(下一页)",
    "removeElementsSelector": "script, style, noscript, iframe, .ad, p:contains(书海阁), p:contains(shuhaige)",
    "prevChapterSelector": "a:contains(上一章)",
    "nextChapterSelector": "a:contains(下一章)"
  },
  "cleanRules": [
    { "pattern": "书海阁小说网|shuhaige\\.[a-z]+", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "本章未完，请点击下一页继续阅读.*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
