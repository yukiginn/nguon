{
  "id": "metruyenchu_vi",
  "name": "Mê Truyện Chữ (VIP & Free)",
  "version": "2.1.0",
  "author": "Cộng Đồng Plugin",
  "description": "Kho truyện chất lượng cao tại Việt Nam, hỗ trợ đăng nhập tài khoản WebView / Cookie để đọc các chương VIP bạn đã mở khóa.",
  "driver": "metruyenchu",
  "language": "vi",
  "isChineseSource": false,
  "baseUrl": "https://metruyencv.com",
  "mirrorUrls": [
    "https://metruyencv.biz",
    "https://metruyenchu.com.vn"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 300,
  "customHeaders": {
    "Accept-Language": "vi-VN,vi;q=0.9,en;q=0.8"
  },
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://metruyencv.com/dang-nhap",
    "loginHint": "Đăng nhập tài khoản Mê Truyện Chữ (MeTruyenCV) của bạn để đồng bộ Cookie và đọc các chương đã mở khóa.",
    "authCookieKeys": ["accessToken", "mtc_token", "session", "XSRF-TOKEN", "cf_clearance"],
    "lockedChapterMarkers": [
      "Mở khóa chương",
      "Chương khóa",
      "Vui lòng đăng nhập để đọc",
      "Dùng Kẹo mở khóa",
      "chương này đã bị khóa"
    ],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "thinh-hanh", "name": "Thịnh Hành", "urlPath": "bang-xep-hang/tuan/thinh-hanh" },
    { "id": "moi-cap-nhat", "name": "Mới Cập Nhật", "urlPath": "truyen?sort_by=new_chap_at" },
    { "id": "tien-hiep", "name": "Tiên Hiệp", "urlPath": "truyen?genre=2" },
    { "id": "huyen-huyen", "name": "Huyền Huyễn", "urlPath": "truyen?genre=3" },
    { "id": "do-thi", "name": "Đô Thị", "urlPath": "truyen?genre=5" },
    { "id": "hoan-thanh", "name": "Hoàn Thành", "urlPath": "truyen?status=2" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{categoryUrl}&page={page}",
    "searchUrlTemplate": "{baseUrl}/truyen?keyword={query}&page={page}",
    "listItemSelector": ".media, .book-item, article",
    "listTitleSelector": "h2 a, h3 a, a[href*='/truyen/']",
    "listAuthorSelector": ".author, [itemprop='author']",
    "listCoverSelector": "img",
    "listLatestChapterSelector": ".chapter, .latest-chapter",
    "detailTitleSelector": "h1",
    "detailAuthorSelector": "a[href*='/tac-gia/'], .author",
    "detailCoverSelector": "img[alt], meta[property='og:image']",
    "detailDescriptionSelector": ".content, meta[property='og:description']",
    "detailStatusSelector": ".status, .badge",
    "detailGenreSelector": "a[href*='genre=']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "a[href*='/chuong-']",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": "h1, .nh-read__title, h2",
    "chapterContentSelector": "#article, #js-read__content, .nh-read__content",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, noscript, iframe, .ads, canvas",
    "prevChapterSelector": "a:contains(Chương trước)",
    "nextChapterSelector": "a:contains(Chương sau)"
  },
  "cleanRules": [
    { "pattern": "metruyencv\\.(com|biz)|metruyenchu\\.com\\.vn", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
