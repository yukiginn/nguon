{
  "id": "qimao_qidian_cn",
  "name": "Thất Miêu & Khởi Điểm (Qimao/Qidian)",
  "version": "2.0.0",
  "author": "Cộng Đồng Plugin",
  "description": "Nguồn chính thống Thất Miêu và Khởi Điểm, hỗ trợ đăng nhập tài khoản cá nhân để đồng bộ đọc các chương VIP đã mở khóa.",
  "driver": "generic",
  "language": "zh",
  "isChineseSource": true,
  "baseUrl": "https://www.qimao.com",
  "mirrorUrls": [
    "https://m.qimao.com",
    "https://www.qidian.com",
    "https://m.qidian.com"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 450,
  "customHeaders": {
    "Accept-Language": "zh-CN,zh;q=0.9,en;q=0.8"
  },
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://www.qimao.com/",
    "loginHint": "Đăng nhập tài khoản Thất Miêu (hoặc đổi sang tên miền Qidian rồi đăng nhập tài khoản Qidian) để đọc chương yêu cầu tài khoản.",
    "authCookieKeys": ["qimao_token", "qm_session", "ywguid", "ywkey", "e1", "e2"],
    "lockedChapterMarkers": [
      "订阅本章节",
      "VIP章节",
      "本章为VIP章节",
      "请先登录",
      "登录后阅读",
      "本章需订阅",
      "下载七猫"
    ],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "shuku", "name": "Kho Truyện Tổng Hợp", "urlPath": "shuku/a-a-a-a-a-a-a-click-1/" },
    { "id": "rank_male", "name": "Bảng Nam Hot", "urlPath": "paihang/boy/hot/date/" },
    { "id": "rank_female", "name": "Bảng Nữ Ngôn Tình", "urlPath": "paihang/girl/hot/date/" },
    { "id": "full", "name": "Truyện Đã Hoàn Thành", "urlPath": "shuku/a-a-a-a-1-a-a-click-1/" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}/shuku/a-a-a-a-a-a-a-click-{page}/",
    "searchUrlTemplate": "{baseUrl}/search/index/?keyword={query}",
    "listItemSelector": ".qm-pic-txt li, .rank-list li, .book-img-text li, .search-list li",
    "listTitleSelector": ".s-tit a, h2 a, h4 a, a[href*='/shuku/']",
    "listAuthorSelector": ".s-des a, .author a, .name",
    "listCoverSelector": "img",
    "listLatestChapterSelector": ".update a, .s-des",
    "detailTitleSelector": ".title .txt, .book-info h1, h1",
    "detailAuthorSelector": ".sub-title a, .writer, .author",
    "detailCoverSelector": ".wrap-pic img, .book-img img, meta[property='og:image']",
    "detailDescriptionSelector": ".intro, .book-intro p, meta[property='og:description']",
    "detailStatusSelector": ".tags-wrap em, .tag span",
    "detailGenreSelector": ".tags-wrap a, .tag a",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": ".chapter-list li a, .volume ul li a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": "h2.chapter-title, h1.j_chapterName, h1",
    "chapterContentSelector": ".article, .read-content, .content",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, noscript, iframe, .qm-download-tip, .review-count",
    "prevChapterSelector": "a:contains(上一章), #j_chapterPrev",
    "nextChapterSelector": "a:contains(下一章), #j_chapterNext"
  },
  "cleanRules": [
    { "pattern": "七猫中文网|qimao\\.com|起点中文网|qidian\\.com", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
