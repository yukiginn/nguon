{
  "id": "truyenchu_sstruyen_vi",
  "name": "Truyện Chữ & SSTruyen",
  "version": "2.0.0",
  "author": "Cộng Đồng Plugin",
  "description": "Nguồn truyện chữ tiếng Việt miễn phí đa thể loại, tốc độ cao, kèm tên miền dự phòng SSTruyen.",
  "driver": "generic",
  "language": "vi",
  "isChineseSource": false,
  "baseUrl": "https://truyenchu.vn",
  "mirrorUrls": [
    "https://sstruyen.vn",
    "https://sstruyen.com",
    "https://truyenfull.io"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 200,
  "customHeaders": {
    "Accept-Language": "vi-VN,vi;q=0.9"
  },
  "authConfig": {
    "supportsLogin": false,
    "loginUrl": "https://truyenchu.vn/",
    "loginHint": "Nguồn đọc miễn phí hoàn toàn.",
    "authCookieKeys": [],
    "lockedChapterMarkers": [],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "hot", "name": "Truyện Hot", "urlPath": "danh-sach/truyen-hot" },
    { "id": "moi", "name": "Mới Cập Nhật", "urlPath": "danh-sach/truyen-moi" },
    { "id": "full", "name": "Truyện Full", "urlPath": "danh-sach/truyen-full" },
    { "id": "tienhiep", "name": "Tiên Hiệp", "urlPath": "the-loai/tien-hiep" },
    { "id": "ngontinh", "name": "Ngôn Tình", "urlPath": "the-loai/ngon-tinh" },
    { "id": "huyenhuyen", "name": "Huyền Huyễn", "urlPath": "the-loai/huyen-huyen" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}/",
    "listPageUrlTemplate": "{categoryUrl}/trang-{page}/",
    "searchUrlTemplate": "{baseUrl}/tim-kiem/?tukhoa={query}&page={page}",
    "listItemSelector": ".list-truyen .row, .table-list tr, .list-truyen [itemscope]",
    "listTitleSelector": ".truyen-title a, h3.rv-sr-a a, h3 a",
    "listAuthorSelector": ".author, [itemprop='author']",
    "listCoverSelector": "[data-desk-image], [data-image], img",
    "listLatestChapterSelector": ".text-info a, .col-chap a",
    "detailTitleSelector": "h3.title, h1.title, h1",
    "detailAuthorSelector": ".info a[itemprop='author'], .author a",
    "detailCoverSelector": "div.book img, meta[property='og:image']",
    "detailDescriptionSelector": "div.desc-text, .scrolltext, [itemprop='description']",
    "detailStatusSelector": ".info span.text-primary, .info span.text-success, .info",
    "detailGenreSelector": ".info a[itemprop='genre']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#list-chapter ul.list-chapter li a, ul.list-chapter li a, .list-chap ul li a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}/trang-{page}/#list-chapter",
    "chapterTitleSelector": "a.chapter-title, h2.chapter-title, .rv-chapt-title h2, h2",
    "chapterContentSelector": "div#chapter-c, .chapter-c, .content.container1",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "noscript, script, style, iframe, .ads, div.ads-responsive, div[id*='ads']",
    "prevChapterSelector": "a#prev_chap, a.prev-chap, a[rel='prev']",
    "nextChapterSelector": "a#next_chap, a.next-chap, a[rel='next']"
  },
  "cleanRules": [
    { "pattern": "truyenchu\\.vn|sstruyen\\.(vn|com)", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
