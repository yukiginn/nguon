{
  "id": "plugin_dichtienghoa",
  "name": "Dịch Tiếng Hoa",
  "version": "1.0.2",
  "author": "Truyện TTS",
  "description": "Kho truyện Trung Quốc dịch tiếng Việt cập nhật liên tục trên Dịch Tiếng Hoa. Hỗ trợ đăng nhập tài khoản để đọc chương VIP/thành viên.",
  "language": "vi",
  "baseUrl": "https://dichtienghoa.app",
  "mirrorUrls": [
    "https://dichtienghoa.net"
  ],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "requestDelayMs": 300,
  "customHeaders": {},
  "chapterPageSize": 100,
  "defaultCategory": "Mới cập nhật",
  "enabled": true,
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://dichtienghoa.app/",
    "loginHint": "Đăng nhập tài khoản Dịch Tiếng Hoa nếu cần đọc chương VIP và vượt xác minh Cloudflare.",
    "authCookieKeys": [
      "cf_clearance"
    ],
    "lockedChapterMarkers": [
      "Chương VIP",
      "Chưa mở khóa"
    ],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "selectors": {
    "listUrlTemplate": "{baseUrl}/tim-kiem?{categoryPath}",
    "listPageUrlTemplate": "{baseUrl}/tim-kiem?{categoryPath}&page={page}",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/tim-kiem?q={query}&sort=updatedAt:desc&page={page}",
    "chapterPageUrlTemplate": "{novelUrl}?page={page}",
    "listItemSelector": "a[href^='/truyen/'], .story-card, article",
    "listTitleSelector": "h3, h2, .title, a[href^='/truyen/']",
    "listAuthorSelector": ".author, a[href*='author=']",
    "listCoverSelector": "img[data-src], img",
    "listLatestChapterSelector": ".chapter, .latest-chapter",
    "detailTitleSelector": "h1",
    "detailAuthorSelector": "a[href*='author=']",
    "detailCoverSelector": "main img, meta[property='og:image']",
    "detailDescriptionSelector": ".description, main p",
    "detailStatusSelector": ".status",
    "detailGenreSelector": "a[href*='category=']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "a[href^='/truyen/'][href*='/']",
    "chapterListStartAfterText": "Danh sách chương",
    "chapterListExcludeSelector": "nav a, header a, footer a",
    "chapterListReverse": false,
    "chapterTitleSelector": "h1, h2",
    "chapterContentSelector": ".chapter-content, article, main",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, nav, header, footer",
    "prevChapterSelector": "a[rel='prev']",
    "nextChapterSelector": "a[rel='next']",
    "blockedUrlPatterns": [
      "/cdn-cgi/",
      "cloudflare"
    ],
    "invalidCoverPatterns": [
      "avatar-",
      "no-cover",
      "placeholder",
      "logo",
      "favicon"
    ],
    "coverUrlReplacements": {},
    "coverFallbackTemplate": "",
    "preferDetailHdCover": false,
    "bookIdExtractRegex": "/truyen/([^/?#]+)"
  },
  "cleanRules": [
    {
      "pattern": "(?:https?://)?(?:www\\.)?dichtienghoa\\.(?:app|net)",
      "replacement": "",
      "isRegex": true,
      "ignoreCase": true
    }
  ],
  "categories": [
    { "name": "Mới cập nhật", "urlOrPath": "sort=updatedAt:desc", "group": "Danh sách", "isDefaultHome": true },
    { "name": "Mới thêm vào", "urlOrPath": "sort=createdAt:desc", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Truyện hoàn thành", "urlOrPath": "status=completed&sort=updatedAt:desc", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Đang cập nhật", "urlOrPath": "status=ongoing&sort=updatedAt:desc", "group": "Danh sách", "isDefaultHome": false },
    { "name": "Tiên hiệp", "urlOrPath": "category=Tiên%20hiệp&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Huyền huyễn", "urlOrPath": "category=Huyền%20huyền&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Đô thị", "urlOrPath": "category=Đô%20Thị&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Ngôn tình", "urlOrPath": "category=Ngôn%20tình&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Light novel", "urlOrPath": "category=Light%20novel&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Đồng nhân", "urlOrPath": "category=Đồng%20nhân&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Xuyên việt", "urlOrPath": "category=Xuyên%20việt&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Kỳ huyễn", "urlOrPath": "category=Kỳ%20huyền&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Huyền nghi", "urlOrPath": "category=Huyền%20nghi&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Linh dị", "urlOrPath": "category=Linh%20dị&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false },
    { "name": "Võng du", "urlOrPath": "category=Võng%20du&sort=updatedAt:desc", "group": "Thể loại", "isDefaultHome": false }
  ]
}
