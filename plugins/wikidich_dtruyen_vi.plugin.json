{
  "id": "wikidich_dtruyen_vi",
  "name": "WikiDịch & Dtruyen (v2)",
  "version": "2.1.0",
  "author": "Cộng Đồng Plugin",
  "description": "Nguồn WikiDịch & Dtruyen chuyên Ngôn Tình, Tiên Hiệp, Đam Mỹ, hỗ trợ đăng nhập tài khoản WebView / Cookie và tên miền dự phòng.",
  "driver": "wikidich",
  "language": "vi",
  "isChineseSource": false,
  "baseUrl": "https://truyenwikidich.net",
  "mirrorUrls": [
    "https://wikidich.com.vn",
    "https://wikicv.net",
    "https://dtruyen.com"
  ],
  "charset": "UTF-8",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 300,
  "customHeaders": {
    "Accept-Language": "vi-VN,vi;q=0.9,en;q=0.8"
  },
  "authConfig": {
    "supportsLogin": true,
    "loginUrl": "https://truyenwikidich.net/login",
    "loginHint": "Đăng nhập tài khoản WikiDịch của bạn trong WebView để đọc các chương giới hạn thành viên hoặc VIP.",
    "authCookieKeys": ["ASP.NET_SessionId", "wikidich_auth", "user_token", "cf_clearance"],
    "lockedChapterMarkers": [
      "Đăng nhập để đọc",
      "Vui lòng đăng nhập",
      "Chương VIP",
      "cần đăng nhập"
    ],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "hot", "name": "Mới Cập Nhật", "urlPath": "tim-kiem?o=1" },
    { "id": "ngontinh", "name": "Ngôn Tình", "urlPath": "the-loai/ngon-tinh" },
    { "id": "tienhiep", "name": "Tiên Hiệp", "urlPath": "the-loai/tien-hiep" },
    { "id": "huyenhuyen", "name": "Huyền Huyễn", "urlPath": "the-loai/huyen-huyen" },
    { "id": "dammy", "name": "Đam Mỹ", "urlPath": "the-loai/dam-my" },
    { "id": "hoanthanh", "name": "Hoàn Thành", "urlPath": "tim-kiem?s=1" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{categoryUrl}&start={page}",
    "searchUrlTemplate": "{baseUrl}/tim-kiem?q={query}",
    "listItemSelector": ".book-list .book-item, .list-stories li",
    "listTitleSelector": ".book-title, h3 a, a[href*='/truyen/']",
    "listAuthorSelector": ".book-author, .author",
    "listCoverSelector": "img",
    "listLatestChapterSelector": ".book-latest-chapter, .chapter",
    "detailTitleSelector": "h2, h1",
    "detailAuthorSelector": "a[href*='/tac-gia/'], .author",
    "detailCoverSelector": ".book-info-pic img, meta[property='og:image']",
    "detailDescriptionSelector": ".book-desc-detail, meta[property='og:description']",
    "detailStatusSelector": ".book-info-text",
    "detailGenreSelector": ".book-desc a[href*='/the-loai/']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#chapterList a, ul.chapters li a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": ".book-title, h2, h1",
    "chapterContentSelector": "#bookContentBody, #chapter-content, #content",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, noscript, iframe, .ads, div[class*='ad']",
    "prevChapterSelector": "a#btnPrevChapter, a:contains(Chương trước)",
    "nextChapterSelector": "a#btnNextChapter, a:contains(Chương sau)"
  },
  "cleanRules": [
    { "pattern": "truyenwikidich\\.net|wikidich\\.com\\.vn|wikicv\\.net|dtruyen\\.com", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
