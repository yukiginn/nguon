{
  "id": "plugin_dtruyen",
  "name": "WebTruyen (DTruyen)",
  "version": "3.1.0",
  "author": "Truyện TTS",
  "description": "Kho truyện ngôn tình, tiên hiệp, kiếm hiệp tiếng Việt với 46 thể loại. Không cần đăng nhập.",
  "language": "vi",
  "baseUrl": "https://wetruyen.com",
  "mirrorUrls": [
    "https://webtruyen.com",
    "https://dtruyen.com"
  ],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "searchMethod": "GET",
  "requestDelayMs": 200,
  "chapterPageSize": 50,
  "defaultCategory": "Truyện mới cập nhật",
  "enabled": true,
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}/",
    "listPageUrlTemplate": "{categoryUrl}/{page}/",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/searching/{query}/all/all/all/",
    "listItemSelector": ".list-truyen .row, .list-stories li, .list-stories .story-list",
    "listTitleSelector": "h3 a, .truyen-title a, .story-title a, a[title]",
    "listAuthorSelector": ".author, [itemprop='author']",
    "listCoverSelector": ".lazyimg, img[data-src], img[src]",
    "listLatestChapterSelector": ".text-info a, .col-chap a, .last-chapter",
    "detailTitleSelector": "h1[itemprop='name'], h1.title, h1",
    "detailAuthorSelector": ".infos a[itemprop='author'], .info a[itemprop='author'], a[itemprop='author']",
    "detailCoverSelector": ".thumb img, div.book img, meta[property='og:image']",
    "detailDescriptionSelector": ".description, div.desc-text, [itemprop='description']",
    "detailStatusSelector": ".infos .status, .info span.text-success, .info",
    "detailGenreSelector": ".infos a[itemprop='genre'], .info a[itemprop='genre'], a[itemprop='genre']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#list-chapter ul.list-chapter li a, ul.list-chapter li a, #chapters ul.chapters li a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}/trang-{page}/#chapter-list",
    "chapterTitleSelector": "h2.chapter-title, h1.chapter-title, .chapter-title, h2",
    "chapterContentSelector": "div#chapter-c, #chapter-content, .chapter-c",
    "removeElementsSelector": "noscript, script, style, iframe, .ads, div[id*='ads'], .ads-responsive, [style*='display: none']",
    "prevChapterSelector": "a#prev_chap, a.prev-chap, a[rel='prev']",
    "nextChapterSelector": "a#next_chap, a.next-chap, a[rel='next']",
    "invalidCoverPatterns": [
      "pixel-cover.gif",
      "/24977-"
    ],
    "coverUrlReplacements": {
      "_cover_small.jpg": "_cover_large.jpg",
      "_cover_list.jpg": "_cover_large.jpg"
    }
  },
  "cleanRules": [
    { "pattern": "webtruyen\\.com|wetruyen\\.com|dtruyen\\.com", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "Bạn đang đọc truyện tại\\s*\\S*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ],
  "categories": [
    { "name": "Truyện mới cập nhật", "urlOrPath": "truyen-moi-cap-nhat", "group": "Danh sách", "isDefaultHome": true },
