{
  "id": "plugin_truyenfull",
  "name": "Truyện Full",
  "version": "3.0.0",
  "author": "Community Plugin",
  "description": "Nguồn truyện Truyện Full (truyenfull.live) chạy 100% bằng cấu hình JSON độc lập, đầy đủ 59 danh mục & thể loại.",
  "language": "vi",
  "baseUrl": "https://truyenfull.live",
  "mirrorUrls": [
    "https://truyenfull.io"
  ],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "searchMethod": "GET",
  "requestDelayMs": 200,
  "chapterPageSize": 50,
  "defaultCategory": "Truyện mới cập nhật",
  "enabled": true,
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}/",
    "listPageUrlTemplate": "{categoryUrl}/trang-{page}/",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/tim-kiem/?tukhoa={query}&page={page}",
    "listItemSelector": ".list-truyen div[itemscope], .list-truyen .row[itemscope], .list-truyen > .row",
    "listTitleSelector": ".truyen-title a, h3.truyen-title a, [itemprop='name'] a",
    "listAuthorSelector": ".author, [itemprop='author']",
    "listCoverSelector": "[data-desk-image], [data-image], picture source, img[itemprop='image'], img",
    "listLatestChapterSelector": ".text-info a, .col-chap a",
    "detailTitleSelector": "h3.title, h1.title, [itemprop='name']",
    "detailAuthorSelector": ".info a[itemprop='author'], a[itemprop='author'], .info a[href*='/tac-gia/']",
    "detailCoverSelector": "div.book img[itemprop='image'], div.book img, meta[property='og:image']",
    "detailDescriptionSelector": "div.desc-text, [itemprop='description']",
    "detailStatusSelector": ".info span.text-success, .info span.text-primary, .info",
    "detailGenreSelector": ".info a[itemprop='genre'], a[itemprop='genre']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#list-chapter ul.list-chapter li a, ul.list-chapter li a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}/trang-{page}/#list-chapter",
    "chapterTitleSelector": "a.chapter-title, h2.chapter-title, .chapter-title, h2",
    "chapterContentSelector": "div#chapter-c, .chapter-c",
    "removeElementsSelector": "noscript, script, style, iframe, .ads, div.ads-responsive, div[id*='ads'], .ads-chapter-box, [style*='display: none']",
    "prevChapterSelector": "a#prev_chap, a[rel='prev']",
    "nextChapterSelector": "a#next_chap, a[rel='next']",
    "blockedUrlPatterns": [
      "-free",
      "-ai-free",
      "/truyen-free"
    ],
    "invalidCoverPatterns": [
      "default.jpg",
      "no-image"
    ]
  },
  "cleanRules": [
    { "pattern": "Truyện Tiên Hiệp Truyện FULL|Truyện FULL|truyenfull\\.(vn|io|vision|live|com)", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "Bạn đang đọc truyện tại\\s*\\S*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ],
  "categories": [
