{
  "id": "plugin_metruyenchu",
  "name": "Mê Truyện Chữ",
  "version": "3.0.0",
  "author": "Community Plugin",
  "description": "Nguồn truyện Mê Truyện Chữ (metruyenchu.com.vn) chạy 100% bằng cấu hình JSON độc lập, đầy đủ 52 danh mục & thể loại.",
  "language": "vi",
  "baseUrl": "https://metruyenchu.com.vn",
  "mirrorUrls": [],
  "driverType": "configurable_css",
  "charset": "UTF-8",
  "searchMethod": "GET",
  "requestDelayMs": 200,
  "chapterPageSize": 100,
  "defaultCategory": "Truyện mới cập nhật",
  "enabled": true,
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{categoryUrl}?page={page}",
    "listPaginationSupported": true,
    "searchUrlTemplate": "{baseUrl}/tim-kiem?q={query}&page={page}",
    "listItemSelector": ".truyen-list .item, .list-truyen .row, .item",
    "listTitleSelector": "h3 a, .truyen-title a, a[href^='/']",
    "listAuthorSelector": ".author, .line a[href*='tac-gia'], [itemprop='author']",
    "listCoverSelector": "img[data-src], img[src], .cover img",
    "listLatestChapterSelector": ".line a[href*='chuong-'], .chapter a",
    "detailTitleSelector": "h1[itemprop='name'], h1.title, h1",
    "detailAuthorSelector": ".book-info-text a[itemprop='author'], a[itemprop='author'], a[href*='/tac-gia/']",
    "detailCoverSelector": ".book-info-pic img, meta[property='og:image'], img[itemprop='image']",
    "detailDescriptionSelector": ".book-desc-detail, .book-info-text .desc, [itemprop='description'], #desc-text",
    "detailStatusSelector": ".book-info-text .status, .label-status, .book-info-text",
    "detailGenreSelector": ".book-info-text a[itemprop='genre'], .book-info-text a[href*='/the-loai/']",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#chapter-list a, .chapter-list a, ul.list-chapter li a, #dsc a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}?page={page}#chapter-list",
    "chapterTitleSelector": "h2.chapter-title, h1.chapter-title, h2, h1",
    "chapterContentSelector": "#vungdoc .truyen, #vungdoc, .chapter-content",
    "removeElementsSelector": "noscript, script, style, iframe, .ads, div[id*='ads'], .box-ads, [style*='display: none']",
    "prevChapterSelector": "#gotochap a.prev, a.prev, a[rel='prev']",
    "nextChapterSelector": "#gotochap a.next, a.next, a[rel='next']",
    "invalidCoverPatterns": [
      "no-cover",
      "default-cover",
      "spacer.gif"
    ]
  },
  "cleanRules": [
    { "pattern": "(?<=[\\p{L}\\p{N}])\\.(?=[\\p{L}\\p{N}])", "replacement": "", "isRegex": true, "ignoreCase": false },
    { "pattern": "metruyenchu\\.com\\.vn|mê truyện chữ", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "Bạn đang đọc truyện tại\\s*\\S*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ],
  "categories": [
    { "name": "Truyện mới cập nhật", "urlOrPath": "truyen-moi", "group": "Danh sách", "isDefaultHome": true },
