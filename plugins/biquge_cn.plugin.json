{
  "id": "biquge_cn",
  "name": "Bút Thú Các (Biquge)",
  "version": "2.0.0",
  "author": "Cộng Đồng Plugin",
  "description": "Hệ thống nguồn Trung miễn phí kinh điển với nhiều tên miền dự phòng dễ chuyển đổi khi bị chặn.",
  "driver": "generic",
  "language": "zh",
  "isChineseSource": true,
  "baseUrl": "https://www.biquge.co",
  "mirrorUrls": [
    "https://www.xbiquge.la",
    "https://www.bqg70.cc",
    "https://www.biqu5200.net"
  ],
  "charset": "auto",
  "convertTraditionalToSimplified": false,
  "searchMethod": "GET",
  "searchBodyTemplate": "",
  "requestDelayMs": 300,
  "customHeaders": {
    "Accept-Language": "zh-CN,zh;q=0.9"
  },
  "authConfig": {
    "supportsLogin": false,
    "loginUrl": "https://www.biquge.co/",
    "loginHint": "Nếu một tên miền Biquge bị lỗi, hãy bấm Tên miền & Kiểm tra để chuyển sang mirror dự phòng.",
    "authCookieKeys": [],
    "lockedChapterMarkers": [],
    "unlockWebUrlTemplate": "{chapterUrl}"
  },
  "categories": [
    { "id": "xuanhuan", "name": "Huyền Huyễn", "urlPath": "xuanhuanxiaoshuo/" },
    { "id": "xiuzhen", "name": "Tu Chân Tiên Hiệp", "urlPath": "xiuzhenxiaoshuo/" },
    { "id": "dushi", "name": "Đô Thị", "urlPath": "dushixiaoshuo/" },
    { "id": "chuanyue", "name": "Xuyên Không Lịch Sử", "urlPath": "chuanyuexiaoshuo/" },
    { "id": "wangyou", "name": "Võng Du", "urlPath": "wangyouxiaoshuo/" },
    { "id": "kehuan", "name": "Khoa Huyễn", "urlPath": "kehuanxiaoshuo/" },
    { "id": "full", "name": "Hoàn Thành", "urlPath": "wanben/" }
  ],
  "selectors": {
    "listUrlTemplate": "{baseUrl}/{categoryPath}",
    "listPageUrlTemplate": "{categoryUrl}",
    "searchUrlTemplate": "{baseUrl}/search.php?q={query}",
    "listItemSelector": "#newscontent .l ul li, .novelslist ul li, .result-list .result-item",
    "listTitleSelector": ".s2 a, h3 a, a.result-game-item-title-link",
    "listAuthorSelector": ".s4, .s5, .result-game-item-info-tag",
    "listCoverSelector": "img",
    "listLatestChapterSelector": ".s3 a",
    "detailTitleSelector": "#info h1, h1",
    "detailAuthorSelector": "#info p:first-of-type, meta[property='og:novel:author']",
    "detailCoverSelector": "#fmimg img, meta[property='og:image']",
    "detailDescriptionSelector": "#intro, meta[property='og:description']",
    "detailStatusSelector": "#info p",
    "detailGenreSelector": ".con_top a:nth-of-type(2)",
    "detailChapterListUrlSelector": "",
    "chapterListSelector": "#list dl dd a, .listmain dl dd a",
    "chapterListReverse": false,
    "chapterPageUrlTemplate": "{novelUrl}",
    "chapterTitleSelector": ".bookname h1, h1",
    "chapterContentSelector": "#content, #chaptercontent",
    "chapterNextPageSelector": "",
    "removeElementsSelector": "script, style, noscript, iframe, .bottem1, .bottem2, p:contains(笔趣阁)",
    "prevChapterSelector": ".bottem1 a:contains(上一章), a:contains(上一章)",
    "nextChapterSelector": ".bottem1 a:contains(下一章), a:contains(下一章)"
  },
  "cleanRules": [
    { "pattern": "笔趣阁|biquge\\.[a-z]+|xbiquge\\.[a-z]+", "replacement": "", "isRegex": true, "ignoreCase": true },
    { "pattern": "请记住本书首发域名.*", "replacement": "", "isRegex": true, "ignoreCase": true }
  ]
}
